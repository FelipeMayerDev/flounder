# Preencha apenas no processo backend (localmente ou no servidor). Não copie estes segredos para o desktop/navegador.
CLIENT_ID=replace_me
CLIENT_SECRET=replace_me
# Gere dois tokens diferentes, por exemplo com openssl rand -hex 32.
APP_TOKEN_1=replace_with_a_random_token_for_client_1
APP_TOKEN_2=replace_with_a_different_random_token_for_client_2
# Use HTTPS no proxy reverso do servidor; o backend escuta no loopback por padrão.
BIND_ADDR=127.0.0.1:3001
# PostgreSQL (sem TLS: use loopback ou rede privada). Também aceita postgres://usuario:senha@host:porta/banco.
DATABASE_URL=host=127.0.0.1 port=5433 user=flounder dbname=flounder password=replace_me
